# Database Configuration - UPDATE THESE VALUES
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Application Configuration
ENVIRONMENT=production
PORT=8000
GEOCODING_USER_AGENT=

# Azure Web App Configuration
WEBSITES_ENABLE_APP_SERVICE_STORAGE=false
WEBSITES_PORT=8000

# Azure Blob Storage (Optional - for multi-instance deployments)
# If provided, all data will be stored in Azure Blob Storage instead of local filesystem
# Required for Azure Web App with multiple instances
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=acceleratorlab-data

# NLP Embedding Service (Optional)
NLP_API_URL=http://localhost:5000
NLP_WRITE_TOKEN=your_write_token
EMBEDDING_DB=your_embedding_db
